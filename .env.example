# Salin ke .env.local lalu isi dari: turso db show <nama-db> --url  &&  turso db tokens create <nama-db>
# Kosongkan saat development lokal: otomatis pakai file local.db
TURSO_DATABASE_URL=libsql://nama-db-username.turso.io
TURSO_AUTH_TOKEN=

# Login /admin/
ADMIN_USER=admin
# ADMIN_PASSWORD_HASH dibuat dengan: node scripts/hash-password.mjs <password>
ADMIN_PASSWORD_HASH=
# SESSION_SECRET dibuat dengan: openssl rand -hex 32
SESSION_SECRET=
# Masuk admin lewat link /admin/masuk/?token=<ADMIN_TOKEN> (min. 16 karakter). Dibuat dengan: openssl rand -hex 24
ADMIN_TOKEN=
